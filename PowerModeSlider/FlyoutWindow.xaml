<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    x:Class="PowerModeSlider.FlyoutWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:winuiex="using:WinUIEx"
    mc:Ignorable="d"
    Title="Power Mode"
    Width="400"
    Height="90"
    IsAlwaysOnTop="True"
    IsResizable="False"
    IsMinimizable="False"
    IsMaximizable="False"
    IsTitleBarVisible="False"
    IsShownInSwitchers="False">

    <Window.SystemBackdrop>
        <DesktopAcrylicBackdrop/>
    </Window.SystemBackdrop>

    <Grid Background="Transparent" Padding="16,12" ColumnSpacing="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" VerticalAlignment="Center">
            <!-- Slider -->
            <Slider x:Name="PowerModeSlider"
                    Minimum="0"
                    Maximum="2"
                    StepFrequency="1"
                    TickFrequency="1"
                    TickPlacement="Outside"
                    SnapsTo="StepValues"
                    HorizontalAlignment="Stretch"
                    ValueChanged="PowerModeSlider_ValueChanged"/>

            <!-- Labels under slider -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Image Grid.Column="0"
                       Source="ms-appx:///Assets/PowerEfficiency.png"
                       Width="22"
                       Height="22"
                       HorizontalAlignment="Left"
                       ToolTipService.ToolTip="Best Power Efficiency"/>
                <Image Grid.Column="1"
                       Source="ms-appx:///Assets/PowerBalanced.png"
                       Width="22"
                       Height="22"
                       HorizontalAlignment="Center"
                       ToolTipService.ToolTip="Balanced"/>
                <Image Grid.Column="2"
                       Source="ms-appx:///Assets/PowerPerformance.png"
                       Width="22"
                       Height="22"
                       HorizontalAlignment="Right"
                       ToolTipService.ToolTip="Best Performance"/>
            </Grid>

            <!-- Hidden text block for code compatibility -->
            <TextBlock x:Name="CurrentModeText" Visibility="Collapsed"/>
        </StackPanel>

        <!-- Keep-awake toggle (caffeine). Keeps the system + display awake while on. -->
        <ToggleButton x:Name="KeepAwakeToggle"
                      Grid.Column="1"
                      VerticalAlignment="Center"
                      Width="48"
                      Height="48"
                      Padding="0"
                      CornerRadius="10"
                      Checked="KeepAwakeToggle_Toggled"
                      Unchecked="KeepAwakeToggle_Toggled"
                      ToolTipService.ToolTip="Keep awake">
            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                      Glyph="&#xEC32;"
                      FontSize="20"/>
        </ToggleButton>
    </Grid>
</winuiex:WindowEx>
